# Backend configuration — used by both local dev and production Docker Compose
# Copy to .env and fill in real values before running.

# Core scraper
SCRAPER_TIMEOUT=30
SCRAPER_FOLLOW_REDIRECTS=true
SCRAPER_ALLOW_PRIVATE_NETWORKS=false
SCRAPER_MAX_REDIRECTS=5
SCRAPER_MAX_LINKS=100
SCRAPER_MAX_IMAGES=50
SCRAPER_MAX_RAW_TEXT_CHARS=50000

# API
API_HOST=127.0.0.1
API_PORT=8000
APP_ENV=production
LOG_LEVEL=INFO
API_ALLOWED_ORIGINS=http://localhost:3000
API_TRUSTED_HOSTS=localhost,127.0.0.1,backend,nginx
API_KEYS=change-me
API_RATE_LIMIT_PER_MINUTE=60
API_SCRAPE_RATE_LIMIT_PER_MINUTE=60
API_RESEARCH_RATE_LIMIT_PER_MINUTE=15
API_WEB_RATE_LIMIT_PER_MINUTE=60
API_MAX_CONCURRENT_REQUESTS=10
API_MAX_REQUEST_BYTES=65536
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me
# PROMETHEUS_ALERT_WEBHOOK_TOKEN: reserved for future Alertmanager webhook integration — not consumed by any service yet
PROMETHEUS_API_KEY=change-me  # Must match one of the values in API_KEYS

# LLM backend
OLLAMA_HOST=http://localhost:11434
DEFAULT_RESEARCH_MODEL=gpt-oss:120b-cloud

# Research runtime knobs
RESEARCH_ENABLE_QUERY_REWRITE=true
RESEARCH_QUERY_REWRITE_MAX_VARIANTS=4
RESEARCH_QUERY_REWRITE_TIMEOUT_SECONDS=20.0
RESEARCH_ENABLE_GOOGLE_FALLBACK=true
RESEARCH_GOOGLE_FALLBACK_MIN_RESULTS=5
RESEARCH_RERANK_DOMAIN_DIVERSITY_BOOST=0.25
RESEARCH_RERANK_SAME_DOMAIN_PENALTY=0.08
RESEARCH_RERANK_EXACT_QUERY_BOOST=0.15
RESEARCH_MAX_CONCURRENT_SOURCES=5
RESEARCH_TIMEOUT_PER_SOURCE=30.0
RESEARCH_NORMAL_AUTO_MIN_SOURCES=1
RESEARCH_NORMAL_AUTO_MAX_SOURCES=15
RESEARCH_DEEP_MIN_SOURCES=15
RESEARCH_DEEP_MAX_SOURCES=50
RESEARCH_DEFAULT_NORMAL_SOURCE_TARGET=5
RESEARCH_DEFAULT_DEEP_SOURCE_TARGET=20
RESEARCH_SEARCH_POOL_EXTRA_NORMAL=5
RESEARCH_SEARCH_POOL_EXTRA_DEEP=10
RESEARCH_NORMAL_CONTENT_LIMIT_CHARS=2500
RESEARCH_DEEP_CONTENT_LIMIT_CHARS=8000
RESEARCH_NON_DEEP_SOURCE_CHAR_CAP=10000
RESEARCH_PLANNING_TIMEOUT_SECONDS=30.0
RESEARCH_SOURCE_SELECTION_TIMEOUT_SECONDS=60.0
RESEARCH_SYNTHESIS_TIMEOUT_SECONDS=120.0
RESEARCH_DEEP_SYNTHESIS_TIMEOUT_SECONDS=240.0
DUCKDUCKGO_REQUEST_TIMEOUT_SECONDS=30.0
DUCKDUCKGO_REQUEST_DELAY_SECONDS=0.5
GOOGLE_REQUEST_TIMEOUT_SECONDS=30.0

# Google no longer returns results to plain HTTP requests. The default path is
# the installed Chrome: the app starts it, minimises its window over CDP and
# keeps one tab, so nothing stays on screen. Camoufox (headless Firefox) is the
# fallback when Chrome is missing or refused.
#
# Legacy research fallback only. The local web tools (REST /api/v1/web/* and the
# MCP server) never use this path: their Google adapter forces headless Chrome
# with allow_visible_browser=False, and their page fetcher has no visible path.
GOOGLE_USE_PLAYWRIGHT=true
GOOGLE_PLAYWRIGHT_TIMEOUT_SECONDS=30.0
GOOGLE_ALLOW_VISIBLE_BROWSER=false
GOOGLE_PLAYWRIGHT_HEADLESS=false
GOOGLE_BROWSER_CHANNEL=chrome

# Local web tools (REST and MCP share these)
WEB_TOOLS_SEARCH_PROVIDER=duckduckgo
# fast: one query; discover: base + current year + historical; deep: adds official/primary
WEB_TOOLS_SEARCH_DEPTH=discover
# Pause between discovery angles so a provider does not see a burst of queries.
WEB_TOOLS_SEARCH_ANGLE_DELAY_MS=150
# DuckDuckGo region (kl) and Accept-Language. wt-wt means no region bias.
WEB_TOOLS_SEARCH_REGION=wt-wt
WEB_TOOLS_SEARCH_LANGUAGE=en-US,en;q=0.9
# Search responses are cached separately from scrapes. Explicit freshness
# queries ("latest", "güncel", "today", or the current year) use DDG date filters.
WEB_TOOLS_SEARCH_CACHE_TTL_SECONDS=300
WEB_TOOLS_SEARCH_TIMEOUT_SECONDS=30
WEB_TOOLS_DEFAULT_SEARCH_LIMIT=5
WEB_TOOLS_MAX_SEARCH_LIMIT=20
# One call at a time per search provider, 250-500 ms apart. A failed call goes down
# the fallback chain, in order ("none" turns it off): DuckDuckGo's lite page over
# plain HTTP, Yahoo over plain HTTP, then the headless Google. The older single WEB_TOOLS_SEARCH_FALLBACK_PROVIDER
# is still read when the chain's variable is unset. A provider that meets a wall (a captcha,
# a bot check), or fails FAILURE_LIMIT times in a row, is skipped for the cooldown (10 minutes),
# twice as long each time it comes back and is refused again, up to the max (an hour); the
# providers that are not cooling are asked by how their last WINDOW_SECONDS of calls went.
WEB_TOOLS_SEARCH_PROVIDER_CONCURRENCY=1
WEB_TOOLS_SEARCH_JITTER_MIN_MS=250
WEB_TOOLS_SEARCH_JITTER_MAX_MS=500
WEB_TOOLS_SEARCH_FALLBACK_PROVIDERS=duckduckgo_lite,yahoo,google
WEB_TOOLS_SEARCH_FALLBACK_TIMEOUT_SECONDS=60
WEB_TOOLS_SEARCH_PROVIDER_COOLDOWN_SECONDS=600
WEB_TOOLS_SEARCH_PROVIDER_MAX_COOLDOWN_SECONDS=3600
WEB_TOOLS_SEARCH_PROVIDER_FAILURE_LIMIT=3
WEB_TOOLS_SEARCH_PROVIDER_WINDOW_SECONDS=1800
# A deep search's primary-source angle may run this long while its side angles are cut at
# WEB_TOOLS_SEARCH_ANGLE_BUDGET_MS (0 gives it the same budget).
WEB_TOOLS_SEARCH_PRIMARY_BUDGET_MS=15000
# Search providers that need a key. Each is on only when its key is set, and then it is asked
# first (DuckDuckGo and the chain stay behind it). The key is read from the environment and
# never written to a log, an error or an answer. `web_health` says which are on.
# BRAVE_SEARCH_API_KEY=
# SERPER_API_KEY=
# Dating search results by reading the head of their pages: auto (news and date-range searches),
# on (every search), off (never, whatever a call says: the server then reads no result page on
# its own). The first BYTES of at most TOP pages, read on to the end of the head up to HEAD_CAP,
# within BUDGET_MS.
WEB_TOOLS_SEARCH_RESOLVE_DATES=auto
WEB_TOOLS_SEARCH_RESOLVE_DATES_TOP=6
WEB_TOOLS_SEARCH_RESOLVE_DATES_MAX=12
WEB_TOOLS_SEARCH_RESOLVE_DATES_BUDGET_MS=4000
WEB_TOOLS_SEARCH_RESOLVE_DATES_BYTES=65536
WEB_TOOLS_SEARCH_RESOLVE_DATES_HEAD_CAP=262144
WEB_TOOLS_SEARCH_RESOLVE_DATES_CONCURRENCY=4
# Hosts added to the tables of first-party sites (official) and of aggregators (ranked lower);
# each a host, or a host and a path (apple.com/newsroom), comma-separated.
# WEB_TOOLS_OFFICIAL_HOSTS=
# WEB_TOOLS_AGGREGATOR_HOSTS=
WEB_TOOLS_FETCH_TIMEOUT_SECONDS=20
WEB_TOOLS_FETCH_RETRIES=1
WEB_TOOLS_MAX_RESPONSE_BYTES=5000000
WEB_TOOLS_MAX_REDIRECTS=5
WEB_TOOLS_GLOBAL_CONCURRENCY=8
WEB_TOOLS_HOST_CONCURRENCY=2
WEB_TOOLS_HOST_MIN_INTERVAL_MS=200
WEB_TOOLS_CACHE_TTL_SECONDS=900
WEB_TOOLS_CACHE_MAX_ENTRIES=256
# The fetched documents web_scrape and web_extract share, so one page is fetched once (0 turns it off).
WEB_TOOLS_PAGE_CACHE_TTL_SECONDS=300
WEB_TOOLS_PAGE_CACHE_MAX_ENTRIES=64
WEB_TOOLS_PAGE_CACHE_MAX_BYTES=20000000
WEB_TOOLS_BROWSER_ENABLED=true
WEB_TOOLS_BROWSER_PREFERENCE=auto
WEB_TOOLS_BROWSER_TIMEOUT_SECONDS=30
WEB_TOOLS_BROWSER_IDLE_SECONDS=120
# A page whose script draws it after it has loaded is read once it has settled: after the load event
# and the network at rest (at most 3 s), until its visible text has stopped growing for
# SETTLE_STABLE_MS and is more than a loading placeholder; never sooner than POST_LOAD_WAIT_MS, never
# later than SETTLE_MAX_MS (a shell that never fills is waited for that long, once) and never past
# BROWSER_TIMEOUT_SECONDS for the whole render.
WEB_TOOLS_BROWSER_POST_LOAD_WAIT_MS=500
WEB_TOOLS_BROWSER_SETTLE_MAX_MS=8000
WEB_TOOLS_BROWSER_SETTLE_STABLE_MS=600
WEB_TOOLS_BROWSER_MAX_CONTEXTS=4
# A page with fewer readable characters than this and scripts in its HTML is read again in the browser.
WEB_TOOLS_BROWSER_RENDER_MIN_CHARS=200
# When a site's bot check turns the headless Chrome away (a captcha, an access wall, HTTP 401/403/429 or a
# timeout), the page is read once more in Camoufox, a Firefox made to look like a person's browser. The package
# camoufox comes with this one; its browser does not (about 100 MB to download, 2.3 GB on disk). false never
# reads a page that way.
WEB_TOOLS_BROWSER_STEALTH=true
# The first time a page needs Camoufox's browser and it is not on this machine, the server runs
# `python -m camoufox fetch` once, in the background (the page that asked is returned as Chrome read it; a later
# one is read in Camoufox). What it downloads is not chosen by this package: see docs/web-tools.md. false never
# fetches by itself: run that command yourself.
WEB_TOOLS_BROWSER_STEALTH_FETCH=true
# A page that does not say it is itself (no canonical link to its own address) may be what its site
# answers any address with. The server then asks the page's host once per session for a path that
# cannot exist (one more request to the same host, through the same checks) and compares; the page that
# is that answer has the warning soft_404. off never asks.
WEB_TOOLS_SOFT_404_CHECK=true
WEB_TOOLS_MARKDOWN_MAX_CHARS=50000
WEB_TOOLS_MAX_LINKS=500
# Links web_scrape lists, from the page content only; map and crawl see them all.
WEB_TOOLS_SCRAPE_MAX_LINKS=50
# web_scrape with urls (2 to 10): pages read at a time (two per host), and the cap on the
# whole answer in characters (a request's max_total_chars replaces it).
WEB_TOOLS_SCRAPE_BATCH_CONCURRENCY=4
WEB_TOOLS_SCRAPE_BATCH_MAX_TOTAL_CHARS=60000
# web_search with read: the cap on the whole answer in characters, the pages' content included.
WEB_TOOLS_SEARCH_READ_MAX_TOTAL_CHARS=60000
WEB_TOOLS_DEFAULT_MAP_LIMIT=500
WEB_TOOLS_MAX_MAP_LIMIT=5000
WEB_TOOLS_MAX_SITEMAPS=25
WEB_TOOLS_RESPECT_ROBOTS=true
WEB_TOOLS_ROBOTS_CACHE_TTL_SECONDS=3600
WEB_TOOLS_DEFAULT_CRAWL_PAGES=20
WEB_TOOLS_MAX_CRAWL_PAGES=100
WEB_TOOLS_DEFAULT_CRAWL_DEPTH=2
WEB_TOOLS_MAX_CRAWL_DEPTH=4
WEB_TOOLS_CRAWL_CONCURRENCY=4
WEB_TOOLS_CRAWL_CONTENT_LIMIT_CHARS=12000
WEB_TOOLS_CRAWL_JOB_TTL_SECONDS=3600
WEB_TOOLS_MAX_CRAWL_JOBS=32
# Crawl jobs are kept in SQLite in this folder, so a restart of the server does not lose them
# (unset: web-research in the XDG data home, ~/.local/share/web-research; empty or "off": none).
# WEB_TOOLS_DATA_DIR=
WEB_TOOLS_MAX_CRAWL_ERRORS=100
# archive: true walks the Internet Archive's copies of a walled page newest first (at
# most four): the time it may take.
WEB_TOOLS_ARCHIVE_BUDGET_SECONDS=20
# A page that answers a captcha, 401, 403, 429 or a bot wall is read another way (the archive's
# copy, its AMP or print form, its feed, another outlet's report) within RECOVER_BUDGET_SECONDS;
# off never does, whatever a call says (the server then reads no page of its own choosing).
WEB_TOOLS_SCRAPE_RECOVER=on
WEB_TOOLS_RECOVER_BUDGET_SECONDS=30
WEB_TOOLS_RECOVER_MAX_ALTERNATES=6
WEB_TOOLS_MAX_EXTRACT_FIELDS=50

# General safety limits
MAX_QUERY_LENGTH=500
MAX_SOURCE_CONTENT_CHARS=12000
CACHE_TTL_SECONDS=300
CACHE_MAX_ENTRIES=256
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_RECOVERY_SECONDS=30
HISTORY_DB_PATH=web_scraper_history.sqlite3
METRICS_ENABLED=true

# Nginx
NGINX_SERVER_NAME=localhost  # Set to your domain in production
