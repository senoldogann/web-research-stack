FROM python:3.13-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    # Google search runs a visible Chromium on the virtual screen below.
    GOOGLE_PLAYWRIGHT_HEADLESS=false \
    GOOGLE_CHROME_NO_SANDBOX=true \
    # Store Playwright browser binaries inside /app so they are
    # accessible by the non-root appuser after chown below.
    PLAYWRIGHT_BROWSERS_PATH=/app/.playwright

WORKDIR /app

COPY pyproject.toml README.md /app/
COPY web_scraper /app/web_scraper

RUN pip install --upgrade pip \
    # Install base deps + playwright + redis optional groups
    && pip install ".[playwright,redis]" \
    # Download Chromium + its system-level OS dependencies in one step
    && playwright install --with-deps chromium \
    # xvfb gives the container a display: Google blocks a headless browser,
    # so the searcher drives a visible Chromium under a virtual screen.
    && apt-get update \
    && apt-get install -y --no-install-recommends xvfb \
    && rm -rf /var/lib/apt/lists/* \
    && addgroup --system appgroup \
    && adduser --system --ingroup appgroup --no-create-home appuser \
    && mkdir -p /app/data \
    # chown covers /app/.playwright so appuser can launch the browser
    && chown -R appuser:appgroup /app

USER appuser

EXPOSE 8000

CMD ["xvfb-run", "-a", "--server-args=-screen 0 1366x900x24", "uvicorn", "web_scraper.api:app", "--host", "0.0.0.0", "--port", "8000", "--proxy-headers"]

